---
// A copyable terminal block. `lines` are rendered verbatim, always LTR.
interface Props {
  lines: string[] | readonly string[];
  label?: string;
}
const { lines, label } = Astro.props;
const copyText = lines.join('\n');
---

<figure class="code-block">
  {label && <figcaption class="code-label">{label}</figcaption>}
  <div class="code-shell">
    <pre><code>{lines.map((line) => <span class="code-line">{line}</span>)}</code></pre>
    <button type="button" class="copy-btn" data-copy={copyText} aria-label="Copy to clipboard">
      <svg class="icon-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="11" height="11" rx="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <svg class="icon-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
    </button>
  </div>
</figure>

<style>
  .code-block { margin: 0; }
  .code-label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
    margin-block-end: 0.5rem;
  }
  .code-shell {
    position: relative;
    background: var(--paper-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    direction: ltr;
    text-align: left;
  }
  :global(:root[data-theme='dark']) .code-shell {
    background: #0f0c09;
    border-color: var(--line);
  }
  pre {
    margin: 0;
    padding: 1rem 3rem 1rem 1.1rem;
    overflow-x: auto;
  }
  code { font-family: var(--font-mono); font-size: 0.9rem; line-height: 1.9; color: var(--ink); }
  .code-line { display: block; white-space: pre; }
  .code-line::before { content: '$ '; color: var(--accent); }
  .copy-btn {
    position: absolute;
    inset-block-start: 0.6rem;
    inset-inline-end: 0.6rem;
    display: inline-grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.4rem;
    background: var(--surface);
    color: var(--ink-faint);
    cursor: pointer;
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease);
  }
  .copy-btn:hover { color: var(--accent); border-color: var(--accent); }
  .copy-btn svg { grid-area: 1 / 1; }
  .icon-check { display: none; color: #3f9d52; }
  .copy-btn.copied .icon-copy { display: none; }
  .copy-btn.copied .icon-check { display: block; }
</style>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy') ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 1600);
      } catch (_) {}
    });
  });
</script>
