---
// The Lore mark: a stack of books in an accent tile, the newest one askew.
// Inline (not <img>) so it follows the theme tokens. Decorative: the
// "Lore" text beside it carries the name. Source: website/brand/lore-mark.svg.
// The default 0.8em is a touch taller than Fraunces' cap height (0.7em, the
// height of "Lore"): it sits on the text baseline (the parent uses
// align-items: baseline) and rises just above the word.
interface Props {
  size?: string;
}
const { size = '0.8em' } = Astro.props;
---

<svg
  class="logo-mark"
  viewBox="4 4 56 56"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <rect x="4" y="4" width="56" height="56" rx="14" fill="var(--accent)" />
  <g fill="var(--paper)">
    <rect x="13" y="41" width="38" height="9" rx="3" />
    <rect x="16" y="29.5" width="32" height="9" rx="3" />
    <rect x="15" y="17" width="28" height="9" rx="3" transform="rotate(-9 29 21.5)" />
  </g>
</svg>

<style>
  .logo-mark {
    flex: none;
    display: block;
  }
</style>
