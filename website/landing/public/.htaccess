# Served from lorekit.net root (Astro copies public/ to the dist root).

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# Long-cache fingerprinted assets (Astro emits hashed files under /_astro/).
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
