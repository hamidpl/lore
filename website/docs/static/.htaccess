# Served from docs.lorekit.net root (Docusaurus copies static/ to the build root).

# Custom 404 — Docusaurus generates 404.html at the site root.
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# Long-cache fingerprinted assets (filenames include a content hash).
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
